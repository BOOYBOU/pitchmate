rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Matches collection
    match /matches/{matchId} {
      allow read: if true; // Public read for all registered and visitor players
      allow write: if true; // Allow write operations for pitch reservations and rosters
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Match comments collection
    match /match_comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Direct messages collection
    match /direct_messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
